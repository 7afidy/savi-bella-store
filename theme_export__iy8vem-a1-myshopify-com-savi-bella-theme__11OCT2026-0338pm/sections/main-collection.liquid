<section class="section">
  <div class="wrap">
    <div class="section__head">
      <h1>{{ collection.title | default: 'Catalogo' }}</h1>
      {%- if collection.description != blank -%}<div class="rte">{{ collection.description }}</div>{%- endif -%}
    </div>
    {%- paginate collection.products by 12 -%}
      <div class="grid grid--4">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- else -%}
          <p>{{ 'collections.general.no_products' | t }}</p>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <div class="pagination">
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}<span class="{% if part.title == paginate.current_page %}is-current{% endif %}">{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}
{ "name": "Collezione", "settings": [] }
{% endschema %}
