<section class="section section--blush">
  <div class="wrap">
    <div class="section__head">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="reviews">
      {%- for block in section.blocks -%}
        <article class="review" {{ block.shopify_attributes }}>
          {% render 'star-rating', rating: block.settings.rating %}
          <p>{{ block.settings.text }}</p>
          <p class="review__who">{{ block.settings.author }} · <span class="review__verified">{{ block.settings.tag }}</span></p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Recensioni",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Cosa dicono le clienti" },
    { "type": "text", "id": "subheading", "label": "Sottotitolo", "default": "Recensioni raccolte dopo l'acquisto." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Recensione",
      "settings": [
        { "type": "range", "id": "rating", "min": 3, "max": 5, "step": 1, "label": "Stelle", "default": 5 },
        { "type": "textarea", "id": "text", "label": "Testo", "default": "Lo uso da un mese la sera davanti alla TV. Le righe sul collo si vedono ancora, ma molto meno marcate. La pelle è più compatta." },
        { "type": "text", "id": "author", "label": "Nome", "default": "Giulia M." },
        { "type": "text", "id": "tag", "label": "Etichetta", "default": "Acquisto verificato" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Recensioni", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
