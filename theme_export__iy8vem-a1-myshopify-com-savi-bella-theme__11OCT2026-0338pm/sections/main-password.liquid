<section class="section" style="text-align:center">
  <div class="wrap wrap--narrow">
    <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}" style="max-height:90px;margin:0 auto 24px">
    <h1>{{ section.settings.heading }}</h1>
    <p style="color:var(--muted)">{{ section.settings.text }}</p>
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div style="display:flex;gap:10px;max-width:420px;margin:24px auto 0">
        <input type="password" name="password" placeholder="Password" style="flex:1;padding:13px 16px;border:1px solid var(--line);border-radius:999px;font:inherit">
        <button type="submit" class="btn btn--primary">{{ 'general.password.submit' | t }}</button>
      </div>
    {%- endform -%}
  </div>
</section>
{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Apriamo a breve" },
    { "type": "textarea", "id": "text", "label": "Testo", "default": "Stiamo mettendo a punto gli ultimi dettagli. Torna presto." }
  ]
}
{% endschema %}
