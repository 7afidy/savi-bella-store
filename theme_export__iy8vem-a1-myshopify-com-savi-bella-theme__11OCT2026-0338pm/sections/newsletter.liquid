<section class="newsletter">
  <div class="wrap wrap--narrow">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p style="color:#fff">{{ 'general.newsletter.success' | t }}</p>
      {%- else -%}
        <div class="newsletter__form" style="display:flex;gap:10px;max-width:480px;margin:24px auto 0">
          <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter.placeholder' | t }}" required style="flex:1;padding:15px 18px;border-radius:999px;border:0">
          <button type="submit" class="btn btn--primary">{{ 'general.newsletter.submit' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "10% sul primo ordine" },
    { "type": "textarea", "id": "text", "label": "Testo", "default": "Iscriviti e ricevi il codice sconto via email, insieme ai consigli della nostra estetista." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
