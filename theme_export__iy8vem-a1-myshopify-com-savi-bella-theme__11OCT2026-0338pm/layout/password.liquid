<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Marcellus&display=swap" rel="stylesheet">
  {{ content_for_header }}
  <link rel="stylesheet" href="{{ 'main.css' | asset_url }}">
  <style>
    :root { --pink: {{ settings.color_primary }}; --pink-deep: {{ settings.color_primary_dark }}; --blush: {{ settings.color_background_soft }}; }
    body { background: var(--blush); }
  </style>
</head>
<body class="template-password">
  <main id="MainContent" role="main">{{ content_for_layout }}</main>
</body>
</html>
