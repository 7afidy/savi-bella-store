<section class="section"><div class="wrap" style="max-width:440px">
  <h1>{{ 'customer.reset_password.title' | t }}</h1>
  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
    <div class="form-field"><label for="ResetPassword">{{ 'customer.login.password' | t }}</label><input type="password" id="ResetPassword" name="customer[password]"></div>
    <div class="form-field"><label for="ResetConfirm">{{ 'customer.activate_account.confirm' | t }}</label><input type="password" id="ResetConfirm" name="customer[password_confirmation]"></div>
    <button type="submit" class="btn btn--primary btn--full">{{ 'customer.reset_password.submit' | t }}</button>
  {%- endform -%}
</div></section>
