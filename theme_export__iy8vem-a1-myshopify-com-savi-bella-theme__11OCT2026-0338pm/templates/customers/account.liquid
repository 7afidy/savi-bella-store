<section class="section"><div class="wrap">
  <h1>{{ 'customer.account.title' | t }}</h1>
  <p><a href="{{ routes.account_addresses_url }}">{{ 'customer.account.addresses' | t }}</a> · <a href="{{ routes.account_logout_url }}">{{ 'customer.account.logout' | t }}</a></p>
  {%- if customer.orders.size > 0 -%}
    <table class="cart-table"><thead><tr><th>{{ 'customer.orders.order_number' | t }}</th><th>{{ 'customer.orders.date' | t }}</th><th>{{ 'customer.orders.total' | t }}</th></tr></thead><tbody>
    {%- for order in customer.orders -%}
      <tr><td><a href="{{ order.customer_url }}">{{ order.name }}</a></td><td>{{ order.created_at | date: '%d/%m/%Y' }}</td><td>{{ order.total_price | money }}</td></tr>
    {%- endfor -%}
    </tbody></table>
  {%- else -%}
    <p style="color:var(--muted)">{{ 'customer.orders.none' | t }}</p>
  {%- endif -%}
</div></section>
